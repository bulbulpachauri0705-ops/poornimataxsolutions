# Local-only environment overrides.
#
# Copy this file to `.env.local` and fill in the value.
# `.env.local` matches the `*.local` rule in .gitignore, so it is NEVER
# committed and never deployed to Vercel.
#
# SUPABASE_SERVICE_ROLE_KEY is only used by the local development bypass:
#   - Supabase Dashboard -> Project Settings -> API Keys -> service_role
#
# It lets the Admin Dashboard read data (Leads, Reports) on localhost without
# logging in. It is never bundled into the browser and it is never used in
# production, because the bypass is gated on `import.meta.env.DEV`, which Vite
# statically replaces with `false` for production builds.
#
# Do NOT set this variable in the Vercel dashboard.
SUPABASE_SERVICE_ROLE_KEY=
